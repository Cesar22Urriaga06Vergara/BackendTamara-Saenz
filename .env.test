# Entorno EXCLUSIVO para la suite de pruebas automatizadas (npm test).
# Usa una base de datos separada de la de desarrollo/producción (DB_DATABASE distinto)
# para que los tests nunca toquen datos reales. synchronize=true porque esta base de
# datos es efímera y se recrea desde las entidades en cada corrida — las migraciones
# reales (src/database/migrations) siguen siendo la única fuente de verdad para BD real.
NODE_ENV=test
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=tamara_saenz_db_test
DB_SYNCHRONIZE=true
DB_LOGGING=false

JWT_ACCESS_SECRET=test_secret
JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_SECRET=test_refresh_secret
JWT_REFRESH_EXPIRES_IN=1d

EMPRESA_NOMBRE="Empresa de Pruebas"
EMPRESA_NIT=900000000-1
EMPRESA_SLOGAN="Pruebas"

DIAS_GRACIA_MORA=5
PORCENTAJE_MORA_MENSUAL=1.5
HORIZONTE_MESES_CANON=3
