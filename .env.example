# ================= APP =================
# NODE_ENV: usa "development" solo en tu máquina local.
NODE_ENV=production
PORT=3010
API_PREFIX=api
CORS_ORIGIN=http://localhost:3011
# TZ del proceso. DÉJALO SIN DEFINIR en producción (Railway y su plugin MySQL corren en UTC; si
# el proceso queda en otra zona, mysql2 lee los `datetime`/`creadoEn` corridos). La zona de
# NEGOCIO (vencimiento de cartera, mes de canon) se calcula SIEMPRE en America/Bogota vía Intl
# (`hoyNegocioISO`), sin importar este valor.
# TZ=
# SWAGGER_ENABLED: "true" solo en local. Swagger expone TODO el esquema del API sin auth.
SWAGGER_ENABLED=false
# UPLOADS_DIR: raíz de los archivos subidos (hoy solo el logo de empresa).
# Vacío = <repo>/uploads (dev). En Railway: el mountPath de un Volume (p. ej. /data/uploads) —
# sin eso, el logo se pierde en cada deploy (FS efímero).
UPLOADS_DIR=

# ================= DATABASE (MySQL 8 — Railway; driver mysql2) =================
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=changeme
DB_DATABASE=tamara_saenz_erp
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ================= JWT =================
# Genera el secreto (NO uses este texto): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=REEMPLAZAR_con_openssl_rand_hex_32
JWT_ACCESS_EXPIRES_IN=15m
# Vida del refresh token (sesión). "1d" = login diario. Acepta "Nd" (días) o "Nh" (horas).
JWT_REFRESH_EXPIRES_IN=1d
# (No hay JWT_REFRESH_SECRET: los refresh tokens son cadenas opacas aleatorias hasheadas con SHA-256, no JWTs.)

# ================= PROXY / RED =================
# Nº de saltos de reverse-proxy a confiar para resolver la IP real del cliente
# (req.ip, usado en la auditoría). "false" = sin proxy (desarrollo local). En prod
# detrás de un LB/nginx suele ser "1". También acepta "true". Cualquier otro valor
# se ignora (queda deshabilitado) en vez de tumbar el arranque del backend.
TRUST_PROXY=false

# ================= OBSERVABILIDAD =================
# Vacío = Sentry desactivado (dev/test). En prod: el DSN del proyecto Sentry del backend.
# Un 500 en producción debe aparecer en Sentry con stack trace — ese es el criterio de "funciona".
SENTRY_DSN=
# Muestreo de trazas de performance (0..1). Bajo por defecto por la cuota del free tier.
SENTRY_TRACES_SAMPLE_RATE=0.1
# Nivel de log (pino): debug|info|warn|error|silent. Vacío = "info" en prod, "debug" en dev,
# "silent" en test. En dev local los logs salen legibles (pino-pretty); en prod, JSON de una línea.
LOG_LEVEL=

# ================= EMPRESA (seed inicial) =================
EMPRESA_NOMBRE="Inversiones Tamara & Saenz S. En C."
EMPRESA_NIT=900000000-1
EMPRESA_SLOGAN="Resolvemos tu situacion"

# ================= NEGOCIO (parametros globales por defecto) =================
HORIZONTE_MESES_CANON=3

# ================= SEED USUARIOS INICIALES =================
# SEED_*_PASSWORD son OBLIGATORIAS para `npm run seed` (>= 8 caracteres). Define contraseñas
# fuertes propias; no las reutilices en ningún otro sistema. Después del seed, cámbialas desde
# /administracion (nunca editando este archivo ni el seed).
# IMPORTANTE: si el valor contiene '#', ponlo entre comillas dobles o dotenv lo corta en el '#'.
SEED_ADMIN_EMAIL=admin@tamarasaenz.com
SEED_ADMIN_PASSWORD=
SEED_RECEPCION_EMAIL=recepcion@tamarasaenz.com
SEED_RECEPCION_PASSWORD=
