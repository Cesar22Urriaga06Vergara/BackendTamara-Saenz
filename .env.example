# ================= APP =================
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:3001

# ================= DATABASE (MySQL 8) =================
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=changeme
DB_DATABASE=tamara_saenz_erp
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ================= JWT =================
JWT_ACCESS_SECRET=change_this_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# ================= EMPRESA (seed inicial) =================
EMPRESA_NOMBRE="Inversiones Tamara & Saenz S. En C."
EMPRESA_NIT=900000000-1
EMPRESA_SLOGAN="Resolvemos tu situacion"

# ================= NEGOCIO (parametros globales por defecto) =================
HORIZONTE_MESES_CANON=3

# ================= SEED USUARIOS INICIALES =================
# IMPORTANTE: los valores que contienen '#' DEBEN ir entre comillas dobles,
# de lo contrario dotenv corta el valor en el '#' (ej: "Admin#2026" -> "Admin").
SEED_ADMIN_EMAIL=admin@tamarasaenz.com
SEED_ADMIN_PASSWORD="Admin#2026"
SEED_RECEPCION_EMAIL=recepcion@tamarasaenz.com
SEED_RECEPCION_PASSWORD="Recepcion#2026"
